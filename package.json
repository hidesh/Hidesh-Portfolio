{
  "name": "hidesh-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hidesh Kumar's Portfolio - Monorepo with Next.js frontend and Express backend",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "prepare": "husky",
    "security:audit": "pnpm audit --audit-level=low"
  },
  "devDependencies": {
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.19.43",
    "baseline-browser-mapping": "^2.11.21",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "pnpm": {
    "overrides": {
      "eslint": "^9",
      "postcss": "8.5.28",
      "nanoid@<4": "3.3.18",
      "nanoid@>=4 <6": "5.1.16",
      "brace-expansion@<2": "1.1.18",
      "brace-expansion@>=2 <3": "2.1.4",
      "brace-expansion@>=3": "5.0.9",
      "sharp": "^0.35.4",
      "uuid@>=9 <11": "^11.1.1",
      "js-yaml@<4": "^3.15.2",
      "js-yaml@>=4": "^4.3.2",
      "postcss-selector-parser@>=6 <7": "^6.1.3",
      "@tootallnate/once@<3": "^2.0.1",
      "esbuild": "^0.28.1"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
